GROQ_API_KEY=tu_clave_de_groq
NIKI_FLOW_LANGUAGE=es
NIKI_FLOW_MODEL=whisper-large-v3-turbo

# Palabra clave para activar por voz (ademas de Ctrl+Win+Espacio).
# "hey_jarvis" es un modelo de prueba incluido. Para tu propia frase,
# entrena en openwakeword.com/train y poné la ruta al .onnx descargado
# (este proyecto ya trae wakeword/hey-viki.onnx listo para usar).
NIKI_FLOW_WAKEWORD_MODEL=wakeword/hey-viki.onnx
NIKI_FLOW_WAKEWORD_THRESHOLD=0.5
NIKI_FLOW_WAKEWORD_ENABLED=true

# Ventana de revisión antes de pegar: podés corregir el texto transcripto
# (la corrección queda guardada para el panel de aprendizaje) antes de que
# se pegue. Se auto-acepta sola si no la tocás en NIKI_FLOW_REVIEW_TIMEOUT
# segundos.
NIKI_FLOW_REVIEW_ENABLED=false
NIKI_FLOW_REVIEW_TIMEOUT=4
